{
  // Local development (README "Local development"). Run "SIS: Full stack" for backend + frontend together.
  // Backend: dev profile, PostgreSQL from docker compose on 127.0.0.1:5433, admin / admin123 created on first start.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "SIS: Backend (dev)",
      "request": "launch",
      "mainClass": "com.armikom.sis.SisApplication",
      "projectName": "sis",
      "env": { "SPRING_PROFILES_ACTIVE": "dev" },
      "console": "integratedTerminal",
      "preLaunchTask": "DB: Postgres up"
    },
    {
      "type": "chrome",
      "name": "SIS: Frontend (Chrome)",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Frontend: serve"
    }
  ],
  "compounds": [
    {
      "name": "SIS: Full stack",
      "configurations": ["SIS: Backend (dev)", "SIS: Frontend (Chrome)"],
      "stopAll": true
    }
  ]
}

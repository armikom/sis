{
  // Commands from AGENTS.md. "Check: all" runs what must pass before a commit.
  // Frontend tasks put /opt/homebrew/bin first on PATH: Angular needs Node 22.22.3+ / 24.15+ / 26+, and an older
  // nvm default would fail. Harmless where that directory does not exist.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: Postgres up",
      "detail": "docker compose up -d db (PostgreSQL 17 on 127.0.0.1:5433)",
      "type": "shell",
      "command": "docker compose up -d --wait db",
      "problemMatcher": []
    },
    {
      "label": "DB: Postgres stop",
      "type": "shell",
      "command": "docker compose stop db",
      "problemMatcher": []
    },
    {
      "label": "Backend: run (no debugger)",
      "detail": "./mvnw -Pno-frontend spring-boot:run on :8080",
      "type": "shell",
      "command": "./mvnw -Pno-frontend spring-boot:run",
      "dependsOn": "DB: Postgres up",
      "isBackground": true,
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": { "regexp": "^(APPLICATION FAILED TO START)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Scanning for projects|Attaching agents",
          "endsPattern": "Started SisApplication|APPLICATION FAILED TO START|BUILD FAILURE"
        }
      }
    },
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": { "PATH": "/opt/homebrew/bin:${env:PATH}" } },
      "problemMatcher": []
    },
    {
      "label": "Frontend: serve",
      "detail": "npm start on :4200, /api proxied to :8080",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": { "PATH": "/opt/homebrew/bin:${env:PATH}" } },
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.+)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.|Changes detected",
          "endsPattern": "Local:|Application bundle generation (complete|failed)"
        }
      }
    },
    {
      "label": "Test: backend",
      "detail": "./mvnw -Pno-frontend test (Testcontainers, Docker must run)",
      "type": "shell",
      "command": "./mvnw -Pno-frontend test",
      "group": "test",
      "problemMatcher": "$javac"
    },
    {
      "label": "Test: backend (one class)",
      "detail": "./mvnw -Pno-frontend test -Dtest=<class>",
      "type": "shell",
      "command": "./mvnw -Pno-frontend test -Dtest=${input:testClass}",
      "group": "test",
      "problemMatcher": "$javac"
    },
    {
      "label": "Test: frontend",
      "type": "shell",
      "command": "npm test -- --watch=false",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": { "PATH": "/opt/homebrew/bin:${env:PATH}" } },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build: frontend",
      "type": "shell",
      "command": "npx ng build",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": { "PATH": "/opt/homebrew/bin:${env:PATH}" } },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Check: all",
      "detail": "Backend tests, frontend tests and frontend build (required before committing)",
      "dependsOrder": "sequence",
      "dependsOn": ["Test: backend", "Test: frontend", "Build: frontend"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testClass",
      "type": "promptString",
      "description": "Test class (e.g. CoreApiIntegrationTest)",
      "default": "CoreApiIntegrationTest"
    }
  ]
}

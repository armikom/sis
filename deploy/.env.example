# Copy to deploy/.env (never commit .env). docker compose reads it automatically.

# ---- database (required) ----
# Password of the postgres user "sis" (database "sis"). Only reachable inside the compose network.
DB_PASSWORD=

# ---- application (required) ----
# MUST be identical to APP_MASTER_SECRET of the old yoklama deployment (copy it from the old deploy/.env).
# For a brand-new installation generate one:  openssl rand -base64 32
APP_MASTER_SECRET=
# Bootstrap system admin created on first start. The migration replaces its password hash with the old
# yoklama admin hash when a yoklama account with the same username exists.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# ---- network ----
# Host port on 127.0.0.1 that the Cloudflare tunnel points at.
APP_PORT=8791
# Public URL (used in login links, QR/check-in links).
APP_PUBLIC_BASE_URL=https://sis.armikom.com
# Hosts allowed in mailed login links
APP_LINK_HOSTS=sis.armikom.com,yoklama.armikom.com,seng403-questions.armikom.com

# ---- mail (login links). SMTP is used when SMTP_HOST is set, EWS when EWS_URL is set ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
EWS_URL=

# ---- AI (question review, "ask AI") ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- timezone (the compose file pins Europe/Istanbul for the app; this one is for the db container) ----
TZ=Europe/Istanbul

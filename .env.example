# Copy to .env and customise if needed. All values have development defaults.

# Database password (docker compose: db service and app)
DB_PASSWORD=sis

# Generate a real secret for production: openssl rand -base64 32
# Must stay the same across deployments (device hints are derived from it).
APP_MASTER_SECRET=dGVzdC1tYXN0ZXItc2VjcmV0LWtleS0zMi1ieXRlcyE=

# Fallback public address (no trailing slash). QR and login links normally use the request's address
# (X-Forwarded-* headers); this is used when there is no request or the host is not in APP_LINK_HOSTS.
APP_PUBLIC_BASE_URL=http://localhost:8790
# Comma-separated host names allowed in mailed login links, e.g. sis.armikom.com. Empty: trust the request.
APP_LINK_HOSTS=

# System administrator created on start when no person has this username
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123

# Mail for sign-in links. With SMTP_HOST and EWS_URL empty, links are only written to the app log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address, if it is different from SMTP_USER
MAIL_FROM=
# On-premises Exchange whose SMTP ports are closed: its EWS address. Mail then goes through EWS
# (NTLM, with SMTP_USER and SMTP_PASSWORD) and SMTP_HOST/SMTP_PORT are not used.
EWS_URL=

# Question pool AI (OpenRouter): automatic question check, study explanations and the "ask AI" helper.
# Empty key = AI features off. Model and URL fall back to anthropic/claude-sonnet-5.5 and the OpenRouter API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_URL=

TZ=Europe/Istanbul
